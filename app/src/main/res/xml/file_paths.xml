<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External files directory for photos taken by camera -->
    <external-files-path
        name="my_images"
        path="Pictures/" />
    <!-- External storage for sharing -->
    <external-path
        name="external_files"
        path="." />
    <!-- App-internal cache for temporary files -->
    <cache-path
        name="cached_images"
        path="." />
</paths>
